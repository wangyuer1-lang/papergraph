<Window x:Class="Papergraph.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Papergraph" Title="papergraph" Width="1380" Height="880" MinWidth="800" MinHeight="540" WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#F7F8FA"/><SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="TextBrush" Color="#273747"/><SolidColorBrush x:Key="MutedBrush" Color="#7C8997"/><SolidColorBrush x:Key="BorderBrush" Color="#DFE5EC"/><SolidColorBrush x:Key="HoverBrush" Color="#E9EEF5"/><SolidColorBrush x:Key="AccentBrush" Color="#356FBD"/>
  <Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="SelectionOpacity" Value="0.3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid>
     <Border x:Name="MenuItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition x:Name="IconColumn" Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="ArrowColumn" Width="18"/></Grid.ColumnDefinitions>
       <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
       <TextBlock x:Name="CheckMark" Text="✓" Visibility="Collapsed" VerticalAlignment="Center"/>
       <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
       <TextBlock x:Name="Shortcut" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MutedBrush}" Margin="24,0,0,0" VerticalAlignment="Center"/>
       <TextBlock x:Name="SubmenuArrow" Grid.Column="3" Text="›" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
      <Border x:Name="SubmenuSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5" TextElement.Foreground="{DynamicResource TextBrush}">
       <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="HasItems" Value="True"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter TargetName="IconColumn" Property="Width" Value="0"/><Setter TargetName="ArrowColumn" Property="Width" Value="0"/><Setter TargetName="Shortcut" Property="Visibility" Value="Collapsed"/><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Collapsed"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator"><Setter Property="Margin" Value="7,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource BorderBrush}"/></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBrush}" Padding="9,2"><DockPanel>
   <Menu x:Name="MainMenu" DockPanel.Dock="Left" VerticalAlignment="Center" Background="Transparent" Foreground="{DynamicResource TextBrush}" Margin="0,0,20,0">
    <MenuItem x:Name="FileMenu" Header="_File"/><MenuItem x:Name="EditMenu" Header="_Edit"/><MenuItem x:Name="InsertMenu" Header="_Insert"/><MenuItem x:Name="ViewMenu" Header="_View"/><MenuItem x:Name="HelpMenu" Header="_Help"/>
   </Menu>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Ellipse x:Name="SaveDot" Width="5" Height="5" Fill="#8C9E94" Margin="10,0,15,0" ToolTip="Saved locally"/><Button x:Name="ThemeButton" Content="☾" FontSize="21" Width="39" ToolTip="Switch theme"/><Button x:Name="NewNodeButton" Content="＋" FontSize="22" Width="39" ToolTip="New proposition · or double-click the canvas"/><Button x:Name="ConnectionButton" Content="Links: All" Width="112" Margin="4,0,0,0" ToolTip="Show all, within-frame or cross-frame connections" AutomationProperties.Name="Show connections: All"/><Button x:Name="ArrangeButton" Content="Arrange" Width="76" ToolTip="Arrange inside the selected □ or ◎; otherwise arrange each □ separately. Keeps frames fixed. Ctrl+Z to undo." AutomationProperties.Name="Arrange inside frames"/><Button x:Name="FitButton" Content="Fit all" Width="66" Margin="4,0,0,0" ToolTip="Show all objects on this board · F" AutomationProperties.Name="Fit all objects to view"/><Button x:Name="FitEditButton" Content="Fit edit" Width="72" ToolTip="Fit for editing · 10% minimum · Shift+F" AutomationProperties.Name="Fit for editing"/></StackPanel>
   <TextBox x:Name="DocumentTitleBox" FontSize="14" Padding="2,9" MaxWidth="550" HorizontalAlignment="Left" ToolTip="Paper title"/>
  </DockPanel></Border>
  <DockPanel Grid.Row="1">
   <Border DockPanel.Dock="Left" Width="190" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
    <DockPanel Margin="10,12" LastChildFill="True">
     <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10"><Button x:Name="NewGraphButton" DockPanel.Dock="Right" Content="＋" Width="32" Height="32" Padding="0" FontSize="21" ToolTip="New graph" AutomationProperties.Name="New graph"/><TextBlock Text="Graphs" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
     <ListBox x:Name="GraphList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Graphs">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  <Grid x:Name="Workspace">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <local:GraphSurface x:Name="Graph"/>
   <Button x:Name="BackButton" Content="‹" FontSize="28" Padding="8,0" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" ToolTip="Back · Esc"/>
   <Border x:Name="MultiBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,22" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5"><StackPanel Orientation="Horizontal">
    <Button x:Name="RegionButton" ToolTip="Create □" AutomationProperties.Name="Create rectangular group" Width="48" Height="36"><local:ObjectGlyph Kind="frame" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
    <Button x:Name="CircleButton" ToolTip="Create ◎ · Ctrl+G" AutomationProperties.Name="Group connected points" Width="48" Height="36"><local:ObjectGlyph Kind="circle" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
    <Button x:Name="DeleteButton" Content="Delete" ToolTip="Delete selection" Width="72" Height="36"/>
   </StackPanel></Border>
   <Border x:Name="CardPanel" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
    <Grid x:Name="EditorLayout" Margin="21,14,18,20"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel>
      <Button x:Name="MoreButton" Content="···" FontSize="20" DockPanel.Dock="Right" Width="34" ToolTip="More"/>
      <Button x:Name="LinkButton" Content="↗" FontSize="22" DockPanel.Dock="Right" Width="34" ToolTip="Connect to another point · or drag the small connection handle"/>
      <Button x:Name="ColorButton" HorizontalAlignment="Left" ToolTip="Mark color · highlight for review" AutomationProperties.Name="Mark color" Padding="5,8"><local:ObjectGlyph x:Name="NodeColorDot" Kind="point" Width="20" Height="20"/></Button>
      <local:ObjectGlyph x:Name="EditorSymbol" Kind="frame" Visibility="Collapsed" Stroke="{DynamicResource MutedBrush}" Width="20" Height="20" Margin="5,0,0,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="EditorHeading" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0"/>
     </DockPanel>
     <TextBlock x:Name="EmptyEditor" Grid.Row="1" Text="Select an object" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="7,24,0,0"/>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="CaptionPanel" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,6,0,3" Padding="0,0,0,5">
       <Grid>
        <TextBox x:Name="CaptionBox" FontSize="14" Padding="4,8" ToolTip="Short graph title · Space to show / hide" AutomationProperties.Name="Graph title"/>
        <TextBlock Text="Title" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="4,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=CaptionBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
      </Border>
     <Grid x:Name="NodePanel" Grid.Row="1" Margin="0,8,0,0">
      <TextBox x:Name="PropositionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="18" Padding="4,10,9,10" AutomationProperties.Name="Proposition"/>
     </Grid>
     <ScrollViewer x:Name="EdgePanel" Grid.Row="1" Visibility="Collapsed" Margin="3,24,3,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="EdgeLabel" FontSize="18" Margin="0,0,0,24"/><UniformGrid x:Name="DirectionChoices" Columns="3" Margin="0,0,0,15"/><UniformGrid x:Name="ArrowChoices" Columns="3"/><Button x:Name="CustomRelationButton" Content="Custom…" HorizontalAlignment="Left" FontSize="13" Margin="0,16,0,0"/></StackPanel></ScrollViewer>
     </Grid>
      <Border x:Name="NotesPanel" Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
       <DockPanel LastChildFill="True">
        <TextBlock Text="Notes" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="4,12,0,4"/>
        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="4,6,9,6" AutomationProperties.Name="Notes"/>
       </DockPanel>
      </Border>
    </Grid>
   </Border>
   <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,24" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,9"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ToastText" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"/><Button x:Name="ToastUndo" Content="Undo" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Padding="12,0,0,0"/></StackPanel></Border>
  </Grid>
  </DockPanel>
 </Grid>
</Window>




